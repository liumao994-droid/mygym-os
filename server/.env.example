# ===== MyGym API 服务端环境变量(复制为 .env 使用;.env 不入库) =====

PORT=8787
HOST=127.0.0.1

# SQLite 数据文件路径(相对服务端运行目录)
DB_FILE=server-data/mygym.db

# 会话签名密钥 —— 生产环境必须设置强随机值(缺失时生产模式拒绝启动)
JWT_SECRET=
JWT_EXPIRES_DAYS=30

# 开发/测试登录开关;接入正式认证(微信等)后必须设为 false
DEV_AUTH_ENABLED=true

# 允许的浏览器跨域来源,逗号分隔;开发可用 *,生产必须收敛
ALLOWED_ORIGINS=*

# ---- AI Provider(OpenAI 兼容;Key 只保存在服务端,绝不进前端/构建产物) ----
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=60000

# ---- AI 额度(可配置,不写死在业务代码) ----
AI_DAILY_LIMIT=3
AI_MONTHLY_LIMIT=10

# 云端导入接口请求体上限
MAX_IMPORT_BYTES=25mb
