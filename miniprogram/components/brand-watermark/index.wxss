:host {
  position: absolute;
  inset: 0;
  z-index: 0;
  display: block;
  overflow: hidden;
  pointer-events: none;
}

.watermark {
  position: absolute;
  color: #b8f04b;
  font-weight: 900;
  line-height: 1;
  opacity: 0.075;
  pointer-events: none;
  user-select: none;
}

.size-page { font-size: 420rpx; }
.size-hero { font-size: 230rpx; }
.size-card { font-size: 150rpx; }
.size-small { font-size: 96rpx; }
.pos-tr { top: -76rpx; right: -46rpx; }
.pos-tl { top: -76rpx; left: -46rpx; }
.pos-br { right: -38rpx; bottom: -58rpx; }
.pos-bl { left: -38rpx; bottom: -58rpx; }
.tone-ink { color: #172033; }
.tone-white { color: #ffffff; }
.tone-coral { color: #ff8c70; }
.tone-cyan { color: #4fc3d7; }
.tone-yellow { color: #d5ad25; }
.subtle { opacity: 0.04; }
