:host { display: block; }
.nav-shell {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 90;
  border-top: 1rpx solid rgba(225, 230, 237, 0.95);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 30rpx rgba(23, 32, 51, 0.06);
}
.nav-safe {
  display: flex;
  height: 106rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #89919e;
}
.nav-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 38rpx;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1;
}
.train-icon {
  border-radius: 10rpx;
  background: #edfaca;
  color: #526e1e;
  font-size: 21rpx;
}
.nav-label { font-size: 19rpx; font-weight: 650; }
.active { color: #172033; }
.active .train-icon { background: #b8f04b; color: #172033; }
