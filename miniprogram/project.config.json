{
  "description": "MyGym OS 微信小程序。此处保留 touristappid 游客模式;取得真实 AppID 后请写入本地 project.private.config.json(见 appid.example.json),不要在本文件伪造。",
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "test" },
      { "type": "file", "value": "package.json" },
      { "type": "file", "value": "README.md" }
    ],
    "include": []
  },
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "newFeature": true,
    "bigPackageSizeSupport": true
  },
  "compileType": "miniprogram",
  "libVersion": "latest",
  "appid": "touristappid",
  "projectname": "mygym-os-miniprogram",
  "miniprogramRoot": "./",
  "condition": {}
}
