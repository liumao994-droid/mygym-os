<view class="page wm-host"><brand-watermark size="page" position="tr" subtle/><view class="wm-content">
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <block wx:if="{{exercise}}"><view class="hero wm-host"><brand-watermark size="hero" position="br" tone="white"/><view class="wm-content"><view class="part">{{exercise.partLabel}}部 · {{exercise.isCustom?'自定义动作':'系统动作'}}</view><view class="title">{{exercise.name}}</view><view class="sub">力量历史 · 估算 1RM · 月度趋势</view></view></view>
  <view class="metrics"><view><text class="num">{{stats.sessions}}</text><text>训练次数</text></view><view><text class="num">{{stats.sets}}</text><text>累计组数</text></view><view><text class="num">{{stats.bestWeight}}</text><text>最佳 kg</text></view><view><text class="num">{{stats.best1rm}}</text><text>估算 1RM</text></view></view>
  <view class="section-title">月度趋势</view><view class="panel"><view class="month-row" wx:for="{{months}}" wx:key="key"><view class="month-label num">{{item.key}}</view><view class="bar-track"><view class="bar" style="width: {{item.bar}}%;"></view></view><view class="month-value num">{{item.best}} kg</view></view><view class="empty" wx:if="{{!months.length}}">还没有可计算的力量数据</view></view>
  <view class="section-title">组历史</view><view class="panel"><view class="set-row" wx:for="{{history}}" wx:key="id"><view><view class="set-main num">{{item.weightLabel}} × {{item.reps}}</view><view class="set-date num">{{item.date}} · 第 {{item.setNumber}} 组</view></view><view class="set-rm num" wx:if="{{item.oneRM}}">1RM {{item.oneRM}}</view></view><view class="empty" wx:if="{{!history.length}}">完成这个动作后，历史会显示在这里。</view></view></block>
</view></view>
