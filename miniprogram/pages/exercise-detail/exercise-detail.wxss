.page{min-height:100vh;padding-bottom:70rpx;background:#f2f4f7}.error{margin:24rpx;padding:24rpx;border-radius:14rpx;background:#fff0f0;color:#b44747}.hero{margin:24rpx;padding:32rpx;border-radius:16rpx;background:#172033;color:#fff}.part{color:#b8f04b;font-size:20rpx;font-weight:800}.title{margin-top:8rpx;font-size:40rpx;font-weight:900}.sub{margin-top:7rpx;color:#aeb6c5;font-size:21rpx}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin:0 24rpx}.metrics view{display:flex;flex-direction:column;padding:20rpx 5rpx;border:1rpx solid #e1e5eb;border-radius:13rpx;background:#fff;text-align:center}.metrics text:first-child{font-size:28rpx;font-weight:850}.metrics text:last-child{margin-top:4rpx;color:#818b99;font-size:17rpx}.section-title{margin:30rpx 24rpx 13rpx;font-size:27rpx;font-weight:850}.panel{margin:0 24rpx;border:1rpx solid #e1e5eb;border-radius:16rpx;background:#fff;overflow:hidden}.month-row{display:flex;align-items:center;gap:14rpx;padding:18rpx 21rpx;border-bottom:1rpx solid #edf0f3}.month-label{width:105rpx;color:#687385;font-size:19rpx}.bar-track{flex:1;height:16rpx;border-radius:8rpx;background:#eef1f4;overflow:hidden}.bar{height:100%;border-radius:8rpx;background:#b8f04b}.month-value{width:105rpx;text-align:right;font-size:19rpx;font-weight:750}.set-row{display:flex;align-items:center;justify-content:space-between;padding:19rpx 22rpx;border-bottom:1rpx solid #edf0f3}.set-main{font-size:24rpx;font-weight:800}.set-date{margin-top:4rpx;color:#87909d;font-size:18rpx}.set-rm{padding:8rpx 12rpx;border-radius:9rpx;background:#edfaca;color:#526e1e;font-size:18rpx}.empty{padding:55rpx 20rpx;color:#8a93a1;text-align:center;font-size:21rpx}
