.page {
  min-height: 100vh;
  padding-bottom: 64rpx;
  background: #f2f4f7;
}

.sport-hero {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx;
  padding: 34rpx 32rpx;
  border-radius: 16rpx;
  color: #172033;
}

.hero-coral { background: #ffdfd6; }
.hero-cyan { background: #d8f1f4; }
.hero-yellow { background: #f7e8a7; }

.hero-kicker,
.sheet-kicker {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  opacity: 0.6;
}

.hero-title {
  margin-top: 6rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.hero-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  opacity: 0.68;
}

.hero-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border: 1rpx solid rgba(23, 32, 51, 0.12);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.52);
  font-size: 44rpx;
}

.summary-bar {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 24rpx 22rpx;
}

.summary-number {
  font-size: 42rpx;
  font-weight: 800;
}

.summary-unit {
  color: #7c8593;
  font-size: 22rpx;
}

.create-btn,
.empty-btn {
  margin: 0;
  padding: 0 26rpx;
  border-radius: 12rpx;
  background: #172033;
  color: #b8f04b;
  font-size: 24rpx;
  line-height: 68rpx;
}

.loading {
  padding: 80rpx 24rpx;
  color: #7c8593;
  text-align: center;
}

.record-list {
  position: relative;
  z-index: 1;
  margin: 0 24rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e2e6ec;
  border-radius: 16rpx;
  background: #fff;
}

.record-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 120rpx;
  border-bottom: 1rpx solid #edf0f3;
}

.record-card:last-child { border-bottom: 0; }

.record-date {
  width: 108rpx;
  color: #77808f;
  font-size: 19rpx;
  font-weight: 700;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-title {
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta {
  margin-top: 5rpx;
  overflow: hidden;
  color: #7c8593;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.delete-btn {
  margin: 0;
  padding: 0 12rpx;
  background: transparent;
  color: #b44747;
  font-size: 20rpx;
  line-height: 48rpx;
}

.empty {
  margin: 0 24rpx;
  padding: 74rpx 24rpx;
  border: 1rpx dashed #ccd2db;
  border-radius: 16rpx;
  text-align: center;
}

.empty-icon { font-size: 60rpx; }
.empty-title { margin-top: 18rpx; font-size: 29rpx; font-weight: 800; }
.empty-sub { margin-top: 8rpx; color: #7c8593; font-size: 22rpx; }
.empty-btn { margin: 28rpx auto 0; }

.overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(13, 20, 33, 0.58);
}

.sheet {
  width: 100%;
  max-height: 91vh;
  padding: 28rpx 28rpx 0;
  border-radius: 16rpx 16rpx 0 0;
  background: #f2f4f7;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 22rpx;
}

.sheet-title {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.close-btn {
  margin: 0;
  padding: 0 22rpx;
  border-radius: 10rpx;
  background: #e5e9ee;
  color: #566171;
  font-size: 22rpx;
  line-height: 58rpx;
}

.form-scroll { max-height: 79vh; }

.form-section {
  margin-bottom: 18rpx;
  padding: 26rpx;
  border: 1rpx solid #e2e6ec;
  border-radius: 16rpx;
  background: #fff;
}

.section-label {
  margin-bottom: 22rpx;
  color: #172033;
  font-size: 25rpx;
  font-weight: 800;
}

.field { margin-bottom: 22rpx; }
.field:last-child { margin-bottom: 0; }

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.label {
  margin-bottom: 9rpx;
  color: #77808f;
  font-size: 21rpx;
  font-weight: 600;
}

.input,
.picker-value {
  width: 100%;
  height: 78rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dce1e7;
  border-radius: 11rpx;
  background: #f4f6f8;
  font-size: 26rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value text { color: #929aa6; font-size: 34rpx; }
.center { text-align: center; }

.segment {
  display: flex;
  gap: 8rpx;
  margin-bottom: 22rpx;
  padding: 6rpx;
  border-radius: 12rpx;
  background: #eef1f4;
}

.segment-item {
  flex: 1;
  padding: 17rpx 12rpx;
  border-radius: 9rpx;
  color: #77808f;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.segment-item.on {
  background: #172033;
  color: #b8f04b;
}

.switch-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  color: #465264;
  font-size: 24rpx;
}

.textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #dce1e7;
  border-radius: 11rpx;
  background: #f4f6f8;
  font-size: 25rpx;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 4rpx;
  border-radius: 14rpx;
  background: #b8f04b;
  color: #172033;
  font-size: 28rpx;
  font-weight: 800;
}

.form-bottom { height: 72rpx; }

.score-three { grid-template-columns: repeat(3, 1fr); }

.input-with-segment {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.input-with-segment .input { flex: 1; min-width: 0; }

.mini-segment {
  display: flex;
  flex-shrink: 0;
  padding: 5rpx;
  border-radius: 11rpx;
  background: #eef1f4;
}

.mini-segment text {
  padding: 14rpx 18rpx;
  border-radius: 8rpx;
  color: #7c8593;
  font-size: 21rpx;
}

.mini-segment text.on { background: #172033; color: #b8f04b; }

.pace {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  border-radius: 11rpx;
  background: #edf7f8;
  color: #55717a;
  font-size: 20rpx;
}

.pace text:last-child { color: #23869a; font-weight: 800; }

.set-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.set-head button {
  margin: 0;
  padding: 0 18rpx;
  border-radius: 9rpx;
  background: #edfaca;
  color: #526e1e;
  font-size: 20rpx;
  line-height: 54rpx;
}

.helper { color: #9099a5; font-size: 18rpx; }
.block-helper { margin: -12rpx 0 18rpx; line-height: 1.5; }

.tennis-set {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 11rpx;
  background: #f2f4f7;
}

.set-label { width: 100rpx; color: #657083; font-size: 20rpx; }
.tennis-set input { width: 100rpx; height: 60rpx; border-radius: 8rpx; background: #fff; font-size: 22rpx; text-align: center; }
.tennis-set .remove { margin-left: auto; padding: 8rpx; color: #b44747; font-size: 30rpx; }

.stat-group-title {
  margin: 20rpx 0 12rpx;
  color: #465264;
  font-size: 22rpx;
  font-weight: 800;
}

.tech-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0 16rpx;
}

.training-types,
.rpe-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 22rpx;
}

.training-chip {
  padding: 13rpx 20rpx;
  border: 1rpx solid #dce1e7;
  border-radius: 24rpx;
  background: #f4f6f8;
  color: #6f7a8a;
  font-size: 20rpx;
}

.training-chip.on { border-color: #172033; background: #172033; color: #b8f04b; }
.rpe { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 50%; background: #eef1f4; color: #6f7988; font-size: 20rpx; }
.rpe.on { background: #172033; color: #b8f04b; font-weight: 800; }
.textarea.short { min-height: 110rpx; }
.form-tip { padding: 18rpx 10rpx 0; color: #8a93a1; font-size: 18rpx; text-align: center; }
