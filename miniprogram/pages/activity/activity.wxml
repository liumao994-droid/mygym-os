<view class="page">
  <view class="sport-hero hero-{{meta.tone}}">
    <view>
      <view class="hero-kicker">{{meta.kicker}}</view>
      <view class="hero-title">{{meta.label}}</view>
      <view class="hero-sub">记录每一次投入和进步</view>
    </view>
    <view class="hero-icon">{{meta.icon}}</view>
  </view>

  <view class="summary-bar">
    <view><text class="summary-number num">{{records.length}}</text><text class="summary-unit"> 次记录</text></view>
    <button class="create-btn" bindtap="onCreate">＋ 新建记录</button>
  </view>

  <view class="loading" wx:if="{{loading}}">正在读取云端记录…</view>
  <view class="record-list" wx:elif="{{records.length}}">
    <view class="record-card" wx:for="{{records}}" wx:key="id">
      <view class="record-date num">{{item.date}}</view>
      <view class="record-main" data-id="{{item.id}}" bindtap="onEdit">
        <view class="record-title">{{item.summary}}</view>
        <view class="record-meta">{{item.venue || '未填写场地'}}<text wx:if="{{item.rpe}}"> · 强度 {{item.rpe}}</text></view>
      </view>
      <button class="delete-btn" data-id="{{item.id}}" bindtap="onDelete">删除</button>
    </view>
  </view>
  <view class="empty" wx:else>
    <view class="empty-icon">{{meta.icon}}</view>
    <view class="empty-title">还没有{{meta.label}}记录</view>
    <view class="empty-sub">第一次记录会从这里开始。</view>
    <button class="empty-btn" bindtap="onCreate">记录第一次</button>
  </view>

  <view class="overlay" wx:if="{{formOpen}}" catchtouchmove="noop">
    <view class="sheet">
      <view class="sheet-head">
        <view>
          <view class="sheet-kicker">{{editingId ? 'EDIT RECORD' : 'NEW RECORD'}}</view>
          <view class="sheet-title">{{editingId ? '编辑' : '记录'}}{{meta.label}}</view>
        </view>
        <button class="close-btn" bindtap="onCloseForm">关闭</button>
      </view>

      <scroll-view scroll-y class="form-scroll">
        <view class="form-section">
          <view class="section-label">基本信息</view>
          <view class="field">
            <view class="label">日期</view>
            <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
              <view class="picker-value num">{{form.date}} <text>›</text></view>
            </picker>
          </view>
          <view class="field-grid">
            <view class="field">
              <view class="label">时长（分钟）</view>
              <input class="input num" type="number" value="{{form.durationMin}}" data-field="durationMin" bindinput="onField" placeholder="如 60" />
            </view>
            <view class="field">
              <view class="label">主观强度 RPE</view>
              <input class="input num" type="number" value="{{form.rpe}}" data-field="rpe" bindinput="onField" placeholder="1 - 10" />
            </view>
          </view>
          <view class="field">
            <view class="label">场地</view>
            <input class="input" value="{{form.venue}}" data-field="venue" bindinput="onField" placeholder="如 天河体育中心" />
          </view>
        </view>

        <view class="form-section" wx:if="{{sport !== 'swimming'}}">
          <view class="section-label">对局</view>
          <view class="segment">
            <view class="segment-item {{form.playType === 'singles' ? 'on' : ''}}" data-field="playType" data-value="singles" bindtap="onSelect">单打</view>
            <view class="segment-item {{form.playType === 'doubles' ? 'on' : ''}}" data-field="playType" data-value="doubles" bindtap="onSelect">双打</view>
          </view>
          <view class="field-grid score-grid">
            <view class="field"><view class="label">胜{{sport === 'tennis' ? '盘' : '局'}}</view><input class="input num center" type="number" value="{{form.gamesWon}}" data-field="gamesWon" bindinput="onField" placeholder="0" /></view>
            <view class="field"><view class="label">负{{sport === 'tennis' ? '盘' : '局'}}</view><input class="input num center" type="number" value="{{form.gamesLost}}" data-field="gamesLost" bindinput="onField" placeholder="0" /></view>
          </view>
          <view class="field"><view class="label">对手 / 搭档</view><input class="input" value="{{form.partners}}" data-field="partners" bindinput="onField" placeholder="可选" /></view>
          <view class="switch-line"><text>正式比赛</text><switch checked="{{form.isMatch}}" color="#172033" bindchange="onMatchChange" /></view>
        </view>

        <view class="form-section" wx:if="{{sport === 'swimming'}}">
          <view class="section-label">游泳数据</view>
          <view class="field-grid">
            <view class="field"><view class="label">距离（米）</view><input class="input num" type="digit" value="{{form.distanceM}}" data-field="distanceM" bindinput="onField" placeholder="如 1000" /></view>
            <view class="field"><view class="label">趟数 / 圈数</view><input class="input num" type="number" value="{{form.laps}}" data-field="laps" bindinput="onField" placeholder="可选" /></view>
          </view>
          <view class="field-grid">
            <view class="field"><view class="label">泳池长度（米）</view><input class="input num" type="digit" value="{{form.poolLengthM}}" data-field="poolLengthM" bindinput="onField" placeholder="25 / 50" /></view>
            <view class="field"><view class="label">热量（kcal）</view><input class="input num" type="number" value="{{form.calories}}" data-field="calories" bindinput="onField" placeholder="可选" /></view>
          </view>
          <view class="field"><view class="label">泳姿</view><picker range="{{strokes}}" range-key="label" value="{{strokeIndex}}" bindchange="onStrokeChange"><view class="picker-value">{{form.stroke ? strokes[strokeIndex].label : '请选择'}} <text>›</text></view></picker></view>
        </view>

        <view class="form-section" wx:if="{{sport === 'tennis'}}">
          <view class="section-label">网球详情</view>
          <view class="field"><view class="label">详细比分</view><input class="input num" value="{{form.scoreText}}" data-field="scoreText" bindinput="onField" placeholder="如 6-4 3-6 7-5" /></view>
          <view class="segment">
            <view class="segment-item {{form.indoor === 'outdoor' ? 'on' : ''}}" data-field="indoor" data-value="outdoor" bindtap="onSelect">室外</view>
            <view class="segment-item {{form.indoor === 'indoor' ? 'on' : ''}}" data-field="indoor" data-value="indoor" bindtap="onSelect">室内</view>
          </view>
          <view class="field"><view class="label">场地类型</view><picker range="{{surfaces}}" range-key="label" value="{{surfaceIndex}}" bindchange="onSurfaceChange"><view class="picker-value">{{form.surface ? surfaces[surfaceIndex].label : '请选择'}} <text>›</text></view></picker></view>
        </view>

        <view class="form-section">
          <view class="section-label">训练备注</view>
          <textarea class="textarea" value="{{form.notes}}" data-field="notes" bindinput="onField" placeholder="今天感觉如何？记录值得记住的细节。"></textarea>
        </view>

        <button class="save-btn" loading="{{busy}}" disabled="{{busy}}" bindtap="onSave">{{editingId ? '保存修改' : '完成记录'}}</button>
        <view class="form-bottom"></view>
      </scroll-view>
    </view>
  </view>
</view>
