.page{min-height:100vh;padding-bottom:70rpx;background:#f2f4f7}.head{padding:34rpx 28rpx 22rpx}.title{margin-top:4rpx;font-size:44rpx;font-weight:850}.sub{margin-top:4rpx;color:#7c8593;font-size:22rpx}.month-picker{display:flex;justify-content:space-between;margin:0 24rpx 18rpx;padding:20rpx 24rpx;border:1rpx solid #e1e5eb;border-radius:13rpx;background:#fff;font-size:23rpx;font-weight:750}.month-picker text:last-child{color:#7c8593;font-size:20rpx}.hero{margin:0 24rpx 16rpx;padding:30rpx;border-radius:16rpx;background:#172033;color:#fff}.hero-kicker{color:#b8f04b;font-size:20rpx;font-weight:800}.hero-number{margin-top:12rpx;font-size:70rpx;font-weight:900}.hero-label{color:#aeb6c5;font-size:21rpx}.hero-grid{display:grid;grid-template-columns:repeat(3,1fr);margin-top:25rpx;padding-top:20rpx;border-top:1rpx solid rgba(255,255,255,.12)}.hero-grid view{display:flex;flex-direction:column}.hero-grid text:first-child{font-size:28rpx;font-weight:800}.hero-grid text:last-child{margin-top:3rpx;color:#aeb6c5;font-size:18rpx}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin:0 24rpx}.stats view{display:flex;flex-direction:column;padding:22rpx 10rpx;border:1rpx solid #e1e5eb;border-radius:14rpx;background:#fff;text-align:center}.stats text:first-child{font-size:28rpx;font-weight:850}.stats text:last-child{margin-top:4rpx;color:#818b99;font-size:18rpx}.section-title{margin:30rpx 24rpx 13rpx;font-size:27rpx;font-weight:850}.panel,.ai-card,.year-card{margin:0 24rpx;border:1rpx solid #e1e5eb;border-radius:16rpx;background:#fff}.sport-row{display:flex;justify-content:space-between;padding:19rpx 23rpx;border-bottom:1rpx solid #edf0f3;font-size:22rpx}.sport-row text:last-child{color:#7c8593}.year-card{padding:25rpx;background:#edfaca}.year-title{font-size:27rpx;font-weight:850}.year-copy{margin-top:7rpx;color:#687850;font-size:21rpx}.milestone{display:flex;align-items:center;gap:17rpx;padding:19rpx 23rpx;border-bottom:1rpx solid #edf0f3}.milestone>text{font-size:32rpx}.milestone view view:first-child{font-size:23rpx;font-weight:750}.milestone view view:last-child{margin-top:4rpx;color:#87909d;font-size:18rpx}.empty-line{padding:35rpx;color:#8a93a1;text-align:center;font-size:21rpx}.ai-card{padding:24rpx}.ai-head{display:flex;align-items:center;justify-content:space-between}.ai-title{font-size:25rpx;font-weight:800}.ai-quota{margin-top:4rpx;color:#7d8795;font-size:19rpx}.ai-head button{margin:0;padding:0 24rpx;background:#b8f04b;color:#172033;font-size:21rpx;line-height:62rpx}.ai-text{margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #edf0f3;color:#4d596b;font-size:22rpx;line-height:1.75;white-space:pre-wrap}.ai-note{margin-top:18rpx;color:#88919e;font-size:19rpx;line-height:1.6}
