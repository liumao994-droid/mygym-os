<view class="page wm-host"><brand-watermark size="page" position="br" subtle/><view class="wm-content">
  <view class="head"><view class="eyebrow">PROGRESS REPORT</view><view class="title">报告</view><view class="sub">月度复盘 · 年度成长 · 里程碑</view></view>
  <picker range="{{months}}" range-key="label" bindchange="onMonthChange"><view class="month-picker"><text>{{report.month || selected}}</text><text>切换月份⌄</text></view></picker>
  <view class="hero wm-host" wx:if="{{report}}"><brand-watermark size="hero" position="br" tone="white"/><view class="wm-content"><view class="hero-kicker">{{report.label}}训练报告</view><view class="hero-number num">{{report.sessions + report.activities}}</view><view class="hero-label">本月总运动次数</view><view class="hero-grid"><view><text>{{report.sessions}}</text><text>力量</text></view><view><text>{{report.activities}}</text><text>其他运动</text></view><view><text>{{report.rests}}</text><text>休息</text></view></view></view></view>
  <view class="stats" wx:if="{{report}}"><view><text class="num">{{report.sets}}</text><text>总组数</text></view><view><text class="num">{{report.volume}}</text><text>训练量 kg</text></view><view><text class="num">{{report.minutes}}</text><text>运动分钟</text></view></view>
  <view class="section-title">运动分布</view><view class="panel" wx:if="{{report}}"><view class="sport-row"><text>🏸 羽毛球</text><text>{{report.sportCount.badminton}} 次</text></view><view class="sport-row"><text>🏊 游泳</text><text>{{report.sportCount.swimming}} 次</text></view><view class="sport-row"><text>🎾 网球</text><text>{{report.sportCount.tennis}} 次</text></view><view class="sport-row"><text>🏐 排球</text><text>{{report.sportCount.volleyball}} 次</text></view><view class="sport-row" wx:for="{{report.parts}}" wx:key="id"><text>🏋️ {{item.label}}部</text><text>{{item.count}} 次</text></view><view class="empty-line" wx:if="{{!report.sessions&&!report.activities}}">本月还没有训练数据</view></view>
  <view class="section-title">排球月度统计</view><view class="panel vb-stats" wx:if="{{report}}"><view><text>场次</text><text>{{report.volleyball.count}}</text></view><view><text>局数 / 胜局</text><text>{{report.volleyball.sets}} / {{report.volleyball.wonSets}}</text></view><view><text>个人得分</text><text>{{report.volleyball.personalPoints}}</text></view><view><text>发球 / ACE</text><text>{{report.volleyball.serveAttempts}} / {{report.volleyball.aces}}</text></view><view><text>进攻 / 得分</text><text>{{report.volleyball.attackAttempts}} / {{report.volleyball.attackPoints}}</text></view><view><text>拦网得分</text><text>{{report.volleyball.blockPoints}}</text></view><view><text>一传 / 到位</text><text>{{report.volleyball.receptionAttempts}} / {{report.volleyball.receptionPerfect}}</text></view><view><text>防守 / 有效</text><text>{{report.volleyball.digAttempts}} / {{report.volleyball.digSuccessful}}</text></view><view><text>二传 / 有效</text><text>{{report.volleyball.setAttempts}} / {{report.volleyball.setSuccessful}}</text></view></view>
  <view class="year-card wm-host" wx:if="{{year}}"><brand-watermark size="small" position="tr" tone="ink" subtle/><view class="wm-content"><view class="year-title">{{year.label}}</view><view class="year-copy">{{year.sessions}} 次力量训练 · {{year.activities}} 次其他运动</view><view class="year-copy">排球 {{year.volleyball.count}} 次 · {{year.volleyball.sets}} 局 · 个人 {{year.volleyball.personalPoints}} 分</view></view></view>
  <view class="section-title">里程碑</view><view class="panel"><view class="milestone" wx:for="{{milestones}}" wx:key="title"><text>{{item.icon}}</text><view><view>{{item.title}}</view><view>{{item.detail}}</view></view></view><view class="empty-line" wx:if="{{!milestones.length}}">第一次训练就是下一个里程碑。</view></view>
</view></view>
