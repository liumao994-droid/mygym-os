<view class="page wm-host"><brand-watermark size="page" position="br" subtle/><view class="wm-content">
  <view class="head"><view class="eyebrow">PROGRESS REPORT</view><view class="title">报告</view><view class="sub">月度复盘 · 年度成长 · 里程碑</view></view>
  <picker range="{{months}}" range-key="label" bindchange="onMonthChange"><view class="month-picker"><text>{{report.month || selected}}</text><text>切换月份⌄</text></view></picker>
  <view class="hero wm-host" wx:if="{{report}}"><brand-watermark size="hero" position="br" tone="white"/><view class="wm-content"><view class="hero-kicker">{{report.label}}训练报告</view><view class="hero-number num">{{report.sessions + report.activities}}</view><view class="hero-label">本月总运动次数</view><view class="hero-grid"><view><text>{{report.sessions}}</text><text>力量</text></view><view><text>{{report.activities}}</text><text>其他运动</text></view><view><text>{{report.rests}}</text><text>休息</text></view></view></view></view>
  <view class="stats" wx:if="{{report}}"><view><text class="num">{{report.sets}}</text><text>总组数</text></view><view><text class="num">{{report.volume}}</text><text>训练量 kg</text></view><view><text class="num">{{report.minutes}}</text><text>运动分钟</text></view></view>
  <view class="section-title">运动分布</view><view class="panel" wx:if="{{report}}"><view class="sport-row"><text>🏸 羽毛球</text><text>{{report.sportCount.badminton}} 次</text></view><view class="sport-row"><text>🏊 游泳</text><text>{{report.sportCount.swimming}} 次</text></view><view class="sport-row"><text>🎾 网球</text><text>{{report.sportCount.tennis}} 次</text></view><view class="sport-row" wx:for="{{report.parts}}" wx:key="id"><text>🏋️ {{item.label}}部</text><text>{{item.count}} 次</text></view><view class="empty-line" wx:if="{{!report.sessions&&!report.activities}}">本月还没有训练数据</view></view>
  <view class="year-card wm-host" wx:if="{{year}}"><brand-watermark size="small" position="tr" tone="ink" subtle/><view class="wm-content"><view class="year-title">{{year.label}}</view><view class="year-copy">{{year.sessions}} 次力量训练 · {{year.activities}} 次其他运动</view></view></view>
  <view class="section-title">里程碑</view><view class="panel"><view class="milestone" wx:for="{{milestones}}" wx:key="title"><text>{{item.icon}}</text><view><view>{{item.title}}</view><view>{{item.detail}}</view></view></view><view class="empty-line" wx:if="{{!milestones.length}}">第一次训练就是下一个里程碑。</view></view>
  <view class="section-title">AI 深度分析</view><view class="ai-card"><view class="ai-head"><view><view class="ai-title">AI 训练洞察</view><view class="ai-quota" wx:if="{{quota&&quota.enabled}}">今日剩余 {{quota.daily.remaining}} 次</view><view class="ai-quota" wx:else>服务暂未开启</view></view><button loading="{{busy}}" disabled="{{!quota.enabled||busy}}" bindtap="onAI">生成</button></view><view class="ai-text" wx:if="{{aiText}}">{{aiText}}</view><view class="ai-note" wx:else>只发送本月结构化统计到 MyGym 后端，API Key 不会进入小程序。</view></view>
</view></view>
