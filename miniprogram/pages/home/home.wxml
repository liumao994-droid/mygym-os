<view class="page tab-page wm-host">
  <brand-watermark size="page" position="br" subtle />
  <view class="hero wm-host">
    <brand-watermark size="hero" position="tr" tone="white" />
    <view class="hero-top">
      <view class="hero-copy">
        <view class="brand">MYGYM OS</view>
        <view class="greeting">{{greeting}}，{{user.nickname}}</view>
        <view class="date">{{dateLabel}}</view>
      </view>
      <view class="avatar" bindtap="onLogout">{{avatarChar}}</view>
    </view>
    <view class="hero-status">
      <view>
        <view class="status-kicker">本月记录</view>
        <view class="status-value num">{{monthRecords}}<text class="status-unit"> 次</text></view>
      </view>
      <view class="status-divider"></view>
      <view>
        <view class="status-kicker">最近训练</view>
        <view class="status-value num small-value">{{latestDate}}</view>
      </view>
      <view class="sync-state"><text class="sync-dot"></text>云端已同步</view>
    </view>
  </view>

  <view class="error" wx:if="{{error}}">{{error}}</view>

  <view class="section-head">
    <view>
      <view class="section-eyebrow">QUICK START</view>
      <view class="section-title">今天练什么</view>
    </view>
    <view class="record-count">累计 {{totalRecords}} 次</view>
  </view>

  <view class="sport-grid">
    <view class="sport-card sport-{{item.tone}}" wx:for="{{sports}}" wx:key="id" data-sport="{{item.id}}" bindtap="onSportTap">
      <text class="sport-easter-egg" wx:if="{{item.easterEgg}}">{{item.easterEgg}}</text>
      <view class="sport-top">
        <view class="sport-icon">{{item.emoji}}</view>
        <view class="sport-arrow">›</view>
      </view>
      <view class="sport-name">{{item.label}}</view>
      <view class="sport-meta num">{{item.count || 0}} 次记录</view>
    </view>
  </view>

  <view class="section-head recent-head">
    <view>
      <view class="section-eyebrow">RECENT</view>
      <view class="section-title">最近记录</view>
    </view>
  </view>

  <view class="recent-panel">
    <block wx:for="{{sports}}" wx:key="id">
      <view class="recent-row" wx:if="{{item.recent.length}}" data-sport="{{item.id}}" bindtap="onSportTap">
        <view class="recent-symbol sport-{{item.tone}}">{{item.emoji}}</view>
        <view class="recent-main">
          <view class="recent-name">{{item.recent[0].summary}}</view>
          <view class="recent-meta">{{item.label}} · {{item.recent[0].date}}</view>
        </view>
        <view class="recent-arrow">›</view>
      </view>
    </block>
    <view class="empty" wx:if="{{!totalRecords}}">完成第一次训练后，记录会出现在这里。</view>
  </view>

  <view class="account-line" wx:if="{{user}}">
    <text>{{isWechat ? '微信账号' : 'MyGym OS 账号'}}</text>
    <text class="account-dot">·</text>
    <text bindtap="onLogout">退出登录</text>
  </view>
</view>
