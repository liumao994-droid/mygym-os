.page {
  min-height: 100vh;
  padding-bottom: 72rpx;
  background: #f2f4f7;
}

.page-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 28rpx 26rpx;
}

.page-title {
  margin-top: 5rpx;
  color: #172033;
  font-size: 42rpx;
  font-weight: 800;
}

.page-date {
  margin-top: 6rpx;
  color: #7c8593;
  font-size: 22rpx;
}

.head-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 16rpx;
  background: #172033;
  color: #b8f04b;
  font-size: 32rpx;
  font-weight: 800;
}

.active-card {
  margin: 0 24rpx 18rpx;
  padding: 26rpx 28rpx;
  border-radius: 16rpx;
  background: #172033;
  color: #fff;
}

.active-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.active-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #b8f04b;
  font-size: 21rpx;
  font-weight: 700;
}

.pulse {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b8f04b;
  box-shadow: 0 0 0 7rpx rgba(184, 240, 75, 0.13);
}

.active-arrow {
  color: #9ba5b6;
  font-size: 38rpx;
}

.active-title {
  margin: 12rpx 0 6rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.active-meta {
  color: #aeb6c5;
  font-size: 22rpx;
}

.start-card {
  margin: 0 24rpx;
  padding: 30rpx;
  border: 1rpx solid #e2e6ec;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(23, 32, 51, 0.05);
}

.card-kicker,
.section-kicker {
  color: #8a93a1;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.card-title {
  margin-top: 5rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.card-sub {
  margin-top: 5rpx;
  color: #7c8593;
  font-size: 22rpx;
}

.part-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin: 28rpx 0;
}

.part {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border: 1rpx solid #e2e6ec;
  border-radius: 14rpx;
  background: #f4f6f8;
  color: #4d5767;
  font-weight: 700;
}

.part-on {
  border-color: #172033;
  background: #172033;
  color: #fff;
}

.part-check {
  position: absolute;
  top: 7rpx;
  right: 9rpx;
  color: #b8f04b;
  font-size: 18rpx;
}

.primary-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 14rpx;
  background: #b8f04b;
  color: #172033;
  font-size: 28rpx;
  font-weight: 800;
}

.primary-btn text {
  margin-left: 12rpx;
}

.quick-row {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 24rpx 0;
}

.quick-btn {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 104rpx;
  margin: 0;
  padding: 18rpx;
  border: 1rpx solid #e2e6ec;
  border-radius: 16rpx;
  background: #fff;
  color: #172033;
  line-height: 1.25;
  text-align: left;
}

.quick-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.copy-icon {
  background: #e0f5f7;
  color: #23869a;
}

.rest-icon {
  background: #fff1dc;
  color: #9b6b1d;
}

.quick-title,
.quick-sub {
  display: block;
}

.quick-title {
  font-size: 23rpx;
  font-weight: 800;
}

.quick-sub {
  margin-top: 5rpx;
  color: #89919e;
  font-size: 18rpx;
}

.section-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 38rpx 24rpx 16rpx;
}

.section-title {
  margin-top: 4rpx;
  color: #172033;
  font-size: 32rpx;
  font-weight: 800;
}

.history-count {
  color: #7c8593;
  font-size: 21rpx;
}

.list-card {
  position: relative;
  z-index: 1;
  margin: 0 24rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e2e6ec;
  border-radius: 16rpx;
  background: #fff;
}

.recent-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  border-bottom: 1rpx solid #edf0f3;
}

.recent-row:last-child {
  border-bottom: 0;
}

.recent-date {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: #eafaca;
  color: #42591c;
}

.recent-day {
  font-size: 18rpx;
  font-weight: 800;
}

.recent-main {
  flex: 1;
  min-width: 0;
}

.recent-title {
  overflow: hidden;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-meta {
  margin-top: 5rpx;
  color: #7c8593;
  font-size: 21rpx;
}

.arrow {
  color: #9ca3af;
  font-size: 36rpx;
}

.empty {
  margin: 0 24rpx;
  padding: 50rpx 24rpx;
  border: 1rpx dashed #cfd5dd;
  border-radius: 16rpx;
  color: #8a93a1;
  text-align: center;
}

.empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin: 0 auto 14rpx;
  border-radius: 14rpx;
  background: #e9edf1;
  color: #566171;
  font-size: 34rpx;
}

.other-sports,
.template-list {
  position: relative;
  z-index: 1;
  margin: 0 24rpx;
}

.other-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 12rpx;
  padding: 21rpx 23rpx;
  border-radius: 15rpx;
}

.other-card.coral { background: #ffdfd6; }
.other-card.cyan { background: #d8f1f4; }
.other-card.yellow { background: #f7e8a7; }
.other-card > text:first-child { font-size: 34rpx; }
.other-card > view { flex: 1; }
.other-card > view > view:first-child { font-size: 25rpx; font-weight: 800; }
.other-card > view > view:last-child { margin-top: 4rpx; color: #6f7784; font-size: 19rpx; }
.other-card > text:last-child { color: #606b7b; font-size: 34rpx; }

.template-list { padding: 0 22rpx; border: 1rpx solid #e2e6ec; border-radius: 16rpx; background: #fff; }
.template-row { display: flex; align-items: center; justify-content: space-between; min-height: 100rpx; border-bottom: 1rpx solid #edf0f3; }
.template-row:last-child { border-bottom: 0; }
.template-start { padding: 10rpx 20rpx; border-radius: 10rpx; background: #edfaca; color: #526e1e; font-size: 20rpx; font-weight: 800; }
.empty.compact { position: relative; z-index: 1; padding: 28rpx 20rpx; font-size: 20rpx; }
