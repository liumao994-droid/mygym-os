.page {
  min-height: 100vh;
  padding: 0 32rpx 48rpx;
  background: #f2f4f7;
}

.hero {
  margin: 0 -32rpx;
  padding: 76rpx 48rpx 86rpx;
  background: #172033;
  color: #fff;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-mark {
  position: relative;
  width: 32rpx;
  height: 32rpx;
}

.brand-bar {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 12rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: #b8f04b;
  transform: skew(-10deg);
}

.brand-dot {
  position: absolute;
  right: 0;
  top: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #55c7d9;
}

.brand-name {
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.hero-title {
  margin-top: 64rpx;
  font-size: 50rpx;
  line-height: 1.35;
  font-weight: 800;
}

.hero-line {
  width: 56rpx;
  height: 6rpx;
  margin-top: 32rpx;
  border-radius: 4rpx;
  background: #b8f04b;
}

.hero-meta {
  margin-top: 14rpx;
  color: #aeb6c5;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.login-panel {
  margin-top: -34rpx;
  padding: 34rpx 32rpx 30rpx;
  border: 1rpx solid #e4e8ee;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 14rpx 36rpx rgba(23, 32, 51, 0.1);
}

.mode-tabs { display: flex; gap: 34rpx; margin-bottom: 18rpx; color: #89919f; font-size: 24rpx; font-weight: 700; }
.mode-tabs text { padding-bottom: 9rpx; }
.mode-tabs text.active { border-bottom: 5rpx solid #b8f04b; color: #172033; }

.panel-title {
  margin-top: 6rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.account-form {
  margin-top: 26rpx;
}

.account-login-btn {
  width: 100%;
  margin-top: 26rpx;
  border-radius: 16rpx;
  background: #172033;
  color: #fff;
  font-size: 30rpx;
}

.account-hint {
  margin-top: 14rpx;
  color: #9aa1ad;
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}

.divider {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
  color: #9aa1ad;
  font-size: 20rpx;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #e4e8ee;
}

.wechat-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  height: 96rpx;
  margin-top: 24rpx;
  border-radius: 16rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
}

.wechat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #fff;
  color: #07a651;
  font-size: 18rpx;
  font-weight: 800;
}

.privacy {
  margin-top: 20rpx;
  color: #9aa1ad;
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}
.privacy text { color: #435675; }

.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.input {
  flex: 1;
  height: 72rpx;
  background: #f2f4f7;
  border: 1rpx solid #e4e8ee;
  border-radius: 12rpx;
  padding: 0 20rpx;
}

.full-input {
  width: 100%;
}

.field-label {
  margin-bottom: 10rpx;
  color: #77808f;
  font-size: 22rpx;
}

.next-label {
  margin-top: 24rpx;
}

.footer {
  margin-top: 54rpx;
  color: #9aa1ad;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  text-align: center;
}
