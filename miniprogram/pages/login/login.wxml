<view class="page wm-host">
  <brand-watermark size="page" position="br" subtle />
  <view class="hero wm-host">
    <brand-watermark size="hero" position="tr" tone="white" />
    <view class="brand-row">
      <view class="brand-mark"><view class="brand-bar"></view><view class="brand-dot"></view></view>
      <view class="brand-name">MYGYM OS</view>
    </view>
    <view class="hero-title">把每一次训练，<br />变成看得见的进步。</view>
    <view class="hero-line"></view>
    <view class="hero-meta">TRAIN · TRACK · PROGRESS</view>
  </view>

  <view class="login-panel">
    <view class="mode-tabs">
      <text class="{{mode === 'login' ? 'active' : ''}}" data-mode="login" bindtap="onMode">登录</text>
      <text class="{{mode === 'register' ? 'active' : ''}}" data-mode="register" bindtap="onMode">注册</text>
    </view>
    <view class="panel-title">{{mode === 'login' ? '登录你的训练空间' : '创建 MyGym OS 账号'}}</view>

    <view class="account-form">
      <view class="field-label">用户名</view>
      <input class="input full-input" value="{{account}}" maxlength="32" placeholder="2-32 个字符，不含空格" bindinput="onAccountInput" />
      <block wx:if="{{mode === 'register'}}">
        <view class="field-label next-label">昵称</view>
        <input class="input full-input" value="{{nickname}}" maxlength="24" placeholder="昵称可以与其他用户相同" bindinput="onNicknameInput" />
      </block>
      <view class="field-label next-label">密码</view>
      <input class="input full-input" value="{{password}}" maxlength="128" password placeholder="至少 6 位" bindinput="onPasswordInput" />
      <block wx:if="{{mode === 'register'}}">
        <view class="field-label next-label">确认密码</view>
        <input class="input full-input" value="{{confirmPassword}}" maxlength="128" password placeholder="再次输入密码" bindinput="onConfirmPasswordInput" />
      </block>
      <button class="account-login-btn" loading="{{busy}}" disabled="{{busy}}" bindtap="onAccountSubmit">{{mode === 'login' ? '登录' : '注册并登录'}}</button>
      <view class="account-hint">使用 MyGym OS 账号登录</view>
    </view>

    <view class="divider"><text>或</text></view>

    <button class="wechat-btn" loading="{{busy}}" disabled="{{busy}}" bindtap="onWechatLogin">
      <text class="wechat-icon">We</text>
      <text>微信一键登录</text>
    </button>
    <view class="privacy">继续即表示你已阅读并同意<text data-type="terms" bindtap="onOpenLegal">《用户协议》</text>和<text data-type="privacy" bindtap="onOpenLegal">《隐私政策》</text></view>
  </view>

  <view class="footer">MYGYM OS · 你的训练由你掌控</view>
</view>
