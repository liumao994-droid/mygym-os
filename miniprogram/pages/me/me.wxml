<view class="page tab-page wm-host">
  <brand-watermark size="page" position="tr" subtle />
  <view class="wm-content">
    <view class="page-head"><view><view class="eyebrow">TRAIN · TRACK · GROW</view><view class="page-title">我的</view></view><view class="avatar avatar-{{profile.avatar}}">{{avatarChar}}</view></view>

    <view class="profile-card wm-host">
      <brand-watermark size="card" position="br" tone="white" />
      <view class="wm-content profile-content">
        <view class="profile-row"><view class="profile-name">{{profile.nickname || 'MyGym 用户'}}</view><button class="edit-profile" size="mini" bindtap="onEditProfile">编辑资料</button></view>
        <view class="profile-bio">{{profile.bio || '记录每一次运动，见证长期进步。'}}</view>
        <view class="profile-meta">{{user.authProvider === 'wechat' ? '微信账号' : 'MyGym OS 账号'}} · 云端数据按账号隔离</view>
      </view>
    </view>

    <view class="profile-editor" wx:if="{{editingProfile}}">
      <view class="editor-title">编辑个人资料</view>
      <view class="editor-label">内置头像</view>
      <view class="avatar-options">
        <view wx:for="{{avatars}}" wx:key="*this" class="avatar-choice avatar-{{item}} {{profileForm.avatar === item ? 'selected' : ''}}" data-avatar="{{item}}" bindtap="onAvatar">{{avatarChar}}</view>
      </view>
      <view class="editor-label">昵称</view>
      <input class="editor-input" maxlength="24" value="{{profileForm.nickname}}" data-key="nickname" bindinput="onProfileInput" />
      <view class="editor-label">个人简介</view>
      <textarea class="editor-textarea" maxlength="120" auto-height value="{{profileForm.bio}}" placeholder="介绍一下你的运动习惯" data-key="bio" bindinput="onProfileInput" />
      <view class="editor-label">常用运动</view>
      <view class="sport-options"><text wx:for="{{profileSports}}" wx:key="id" class="{{item.selected ? 'selected' : ''}}" data-sport="{{item.id}}" bindtap="onFavoriteSport">{{item.label}}</text></view>
      <view class="goal-row"><text>每周目标</text><text class="num">{{profileForm.weeklyGoal}} 次</text></view>
      <slider min="1" max="14" step="1" value="{{profileForm.weeklyGoal}}" activeColor="#172033" block-color="#b8f04b" bindchange="onGoal" />
      <view class="editor-actions"><button class="editor-action" bindtap="onCancelProfile">取消</button><button class="editor-action save-profile" loading="{{busy}}" bindtap="onSaveProfile">保存</button></view>
    </view>

    <view class="summary-card">
      <view class="summary-grid">
        <view><text class="stat-value num">{{summary.totalCount}}</text><text class="stat-label">累计次数</text></view>
        <view><text class="stat-value num">{{summary.totalMinutes}}</text><text class="stat-label">累计分钟</text></view>
        <view><text class="stat-value num">{{summary.monthCount}}</text><text class="stat-label">本月次数</text></view>
      </view>
      <view class="weekly-head"><text>本周目标</text><text class="num">{{summary.weeklyCount}} / {{summary.weeklyGoal}}</text></view>
      <view class="progress"><view style="width: {{summary.weeklyPercent}}%"></view></view>
      <view class="weekly-note">按周一至周日统计；力量训练仅计已完成记录。</view>
    </view>

    <view class="section-title">五种运动概览</view>
    <view class="overview-card"><view wx:for="{{overview}}" wx:key="id"><text>{{item.label}}</text><text class="num">{{item.count}} 次</text></view></view>

    <view class="stats-card wm-host">
      <brand-watermark size="small" position="tl" tone="ink" subtle />
      <view class="wm-content stats-grid">
        <view><text class="stat-value num">{{stats.sessions}}</text><text class="stat-label">力量训练</text></view>
        <view><text class="stat-value num">{{stats.activities}}</text><text class="stat-label">其他运动</text></view>
        <view><text class="stat-value num">{{stats.sets}}</text><text class="stat-label">总组数</text></view>
        <view><text class="stat-value num">{{stats.volume}}</text><text class="stat-label">总量 kg</text></view>
      </view>
    </view>

    <view class="entry-grid">
      <view class="entry" data-target="exercises" bindtap="onOpen"><text class="entry-icon">📚</text><text>我的动作</text></view>
      <view class="entry" data-target="templates" bindtap="onOpen"><text class="entry-icon">🔖</text><text>训练模板</text></view>
      <view class="entry" data-target="reports" bindtap="onOpen"><text class="entry-icon">📊</text><text>报告</text></view>
    </view>

    <view class="section-title">通用</view>
    <view class="settings-card">
      <view class="setting-row"><text>重量单位</text><view class="segment"><text class="{{unit === 'kg' ? 'on' : ''}}" data-unit="kg" bindtap="onUnit">kg</text><text class="{{unit === 'lb' ? 'on' : ''}}" data-unit="lb" bindtap="onUnit">lb</text></view></view>
      <view class="setting-note">底层始终以 kg 存储，切换单位只影响显示。</view>
      <view class="setting-row"><text>智能提醒</text><view class="row-right"><text>温和 · 少量</text><switch checked="{{reminders}}" color="#172033" bindchange="onReminder" /></view></view>
    </view>

    <view class="section-title">数据</view>
    <view class="settings-card">
      <view class="action-row" bindtap="onExport"><view><view class="action-title">导出 JSON 备份</view><view class="action-sub">生成与网页版兼容的完整备份</view></view><text>›</text></view>
      <view class="action-row" bindtap="onExportCsv"><view><view class="action-title">导出 CSV 明细</view><view class="action-sub">导出力量训练逐组数据</view></view><text>›</text></view>
      <view class="action-row" bindtap="onImport"><view><view class="action-title">导入 JSON 备份</view><view class="action-sub">安全合并，不删除已有云端资料</view></view><text>›</text></view>
    </view>

    <view class="about-card wm-host"><brand-watermark size="small" position="br" tone="ink" subtle /><view class="wm-content"><view class="about-brand">MyGym<text class="about-accent">OS</text></view><view class="about-tag">TRAIN · TRACK · GROW</view><view class="about-copy">记录训练，沉淀数据，发现进步，长期成长。</view></view></view>
    <button class="logout" bindtap="onLogout">退出登录</button>
  </view>
</view>
