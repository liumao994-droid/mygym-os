.page {
  min-height: 100vh;
  padding-bottom: 80rpx;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eef2f7;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 58rpx;
  padding: 0;
  background: #f1f5fb;
  color: #2e4aae;
  border-radius: 18rpx;
  font-size: 44rpx;
}

.top-info {
  flex: 1;
  min-width: 0;
}

.top-title {
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top-sub {
  font-size: 22rpx;
}

.top-actions {
  display: flex;
  gap: 8rpx;
}

.finish-top-btn {
  margin: 0;
  padding: 0 22rpx;
  line-height: 2.4;
  background: #2e4aae;
  color: #fff;
  border-radius: 14rpx;
  font-size: 26rpx;
}

.icon-btn {
  margin: 0;
  padding: 0 18rpx;
  line-height: 2.4;
  background: #fef2f2;
  color: #b91c1c;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.loading,
.error-box {
  padding: 80rpx 40rpx;
  text-align: center;
}

.back-link {
  margin-top: 24rpx;
  background: #eef2ff;
  color: #2e4aae;
}

.empty-tip {
  margin: 30rpx 24rpx;
  text-align: center;
}

.exercise-card {
  margin: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(46, 74, 174, 0.05);
}

.exercise-head {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.exercise-title {
  flex: 1;
  min-width: 0;
}

.part-badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  color: #2e4aae;
  background: #eef2ff;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  margin-right: 12rpx;
}

.exercise-name {
  font-size: 30rpx;
  font-weight: 700;
}

.remove-ex-btn {
  margin: 0;
  padding: 0 16rpx;
  line-height: 2;
  background: #fef2f2;
  color: #b91c1c;
  border-radius: 10rpx;
  font-size: 22rpx;
}

.set-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx;
  margin-bottom: 8rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  flex-wrap: wrap;
}

.set-no {
  width: 32rpx;
  color: #9ca3af;
  font-size: 22rpx;
}

.set-weight {
  min-width: 120rpx;
  font-weight: 600;
}

.set-reps {
  color: #4b5563;
  min-width: 90rpx;
}

.mini-btn {
  margin: 0;
  padding: 0 12rpx;
  line-height: 2;
  background: #eef2ff;
  color: #2e4aae;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.ghost {
  background: #f1f5f9;
  color: #6b7280;
}

.danger-ghost {
  background: #fef2f2;
  color: #b91c1c;
}

.mini-input {
  width: 100rpx;
  height: 56rpx;
  background: #fff;
  border: 1rpx solid #dbe4f0;
  border-radius: 8rpx;
  text-align: center;
  font-size: 24rpx;
}

.field-label {
  font-size: 20rpx;
  color: #6b7280;
}

.bw-text,
.bw-label {
  color: #6b7280;
  font-weight: 600;
}

.add-inputs {
  margin-top: 12rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #e2e8f0;
}

.input-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.set-input {
  width: 130rpx;
  height: 64rpx;
  background: #f1f5fb;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
}

.set-input.narrow {
  width: 80rpx;
}

.unit-label {
  font-size: 20rpx;
  color: #6b7280;
}

.add-set-btn {
  margin: 0;
  padding: 0 20rpx;
  line-height: 2.6;
  background: #2e4aae;
  color: #fff;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.add-exercise-btn {
  margin: 8rpx 24rpx;
  background: #fff;
  color: #2e4aae;
  border: 2rpx dashed #a5b8e8;
  font-weight: 600;
}

.footer-note {
  margin: 24rpx;
  text-align: center;
}

/* overlay sheets */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.55);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 82vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx;
  box-sizing: border-box;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
}

.close-btn {
  margin: 0;
  padding: 0 16rpx;
  line-height: 2;
  background: #f1f5f9;
  color: #4b5563;
  font-size: 24rpx;
}

.search-input {
  height: 72rpx;
  background: #f1f5fb;
  border-radius: 14rpx;
  padding: 0 20rpx;
}

.part-scroll {
  white-space: nowrap;
  margin: 16rpx 0;
}

.part-scroll-row {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 12rpx;
}

.picker-part {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: #f1f5f9;
  color: #4b5563;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.picker-part.on {
  background: #2e4aae;
  color: #fff;
}

.exercise-scroll {
  height: 56vh;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 12rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.picker-name {
  font-weight: 600;
}

.finish-label {
  margin: 8rpx 0;
  color: #374151;
  font-weight: 600;
}

.feel-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0;
}

.feel-chip {
  padding: 10rpx 20rpx;
  background: #f1f5f9;
  color: #4b5563;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.feel-chip.on {
  background: #c7d2fe;
  color: #2e4aae;
  font-weight: 700;
}

.notes-input {
  width: 100%;
  min-height: 140rpx;
  box-sizing: border-box;
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 18rpx;
}

.finish-btn {
  margin-top: 20rpx;
  background: #2e4aae;
  color: #fff;
}
