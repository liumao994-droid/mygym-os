<view class="page wm-host"><brand-watermark size="page" position="tr" subtle/><view class="wm-content">
  <view class="head"><view><view class="eyebrow">EXERCISE LIBRARY</view><view class="title">我的动作</view><view class="sub">{{exercises.length}} 个动作 · 训练时可直接选择</view></view><button class="add" bindtap="onCreate">＋</button></view>
  <view class="search"><text>⌕</text><input value="{{query}}" bindinput="onSearch" placeholder="搜索动作"/></view>
  <scroll-view scroll-x class="part-scroll" enhanced show-scrollbar="{{false}}"><view class="part-row"><view class="chip {{!filter?'on':''}}" data-id="" bindtap="onFilter">全部</view><view wx:for="{{parts}}" wx:key="id" class="chip {{filter===item.id?'on':''}}" data-id="{{item.id}}" bindtap="onFilter">{{item.label}}</view></view></scroll-view>
  <view class="list"><view class="exercise" wx:for="{{visible}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen"><view class="part-badge">{{item.partLabel}}</view><view class="exercise-main"><view class="exercise-name">{{item.name}}</view><view class="exercise-meta">{{item.isCustom ? '自定义动作' : '系统动作'}} · 点按查看力量历史</view></view><text class="edit-link" data-id="{{item.id}}" catchtap="onEdit">编辑</text><text class="arrow">›</text></view><view class="empty" wx:if="{{!loading&&!visible.length}}">没有匹配的动作</view></view>
</view>
<view class="overlay" wx:if="{{editorOpen}}" catchtouchmove="noop"><view class="sheet"><view class="sheet-head"><view class="sheet-title">{{editingId?'编辑动作':'添加动作'}}</view><text bindtap="onClose">关闭</text></view><view class="label">动作名称</view><input class="input" value="{{form.name}}" bindinput="onName" placeholder="如：上斜哑铃卧推"/><view class="label">训练部位</view><view class="choice-grid"><view wx:for="{{parts}}" wx:key="id" class="choice {{form.bodyPart===item.id?'on':''}}" data-id="{{item.id}}" bindtap="onPart">{{item.label}}</view></view><view class="label">默认重量形式</view><view class="type-grid"><view wx:for="{{weightTypes}}" wx:key="value" class="choice {{form.defaultWeightType===item.value?'on':''}}" data-value="{{item.value}}" bindtap="onType">{{item.label}}</view></view><button class="save" loading="{{busy}}" bindtap="onSave">保存</button><button class="delete" wx:if="{{editingId}}" bindtap="onDelete">删除动作</button></view></view>
</view>
