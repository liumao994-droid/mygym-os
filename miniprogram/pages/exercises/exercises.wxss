.page{min-height:100vh;padding-bottom:60rpx;background:#f2f4f7}.head{display:flex;align-items:center;justify-content:space-between;padding:34rpx 28rpx 22rpx}.title{margin-top:4rpx;font-size:42rpx;font-weight:850}.sub{margin-top:4rpx;color:#7d8795;font-size:21rpx}.add{display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;margin:0;padding:0;border-radius:14rpx;background:#b8f04b;color:#172033;font-size:36rpx}.search{display:flex;align-items:center;gap:12rpx;margin:0 24rpx 16rpx;padding:0 20rpx;height:78rpx;border:1rpx solid #e0e4ea;border-radius:14rpx;background:#fff;color:#7e8896}.search input{flex:1;font-size:25rpx}.part-scroll{white-space:nowrap}.part-row{display:inline-flex;gap:10rpx;padding:0 24rpx 18rpx}.chip{padding:12rpx 24rpx;border:1rpx solid #dfe3e9;border-radius:26rpx;background:#fff;color:#6f7a8a;font-size:22rpx}.chip.on{background:#172033;color:#b8f04b}.list{margin:0 24rpx;border:1rpx solid #e1e5eb;border-radius:16rpx;background:#fff;overflow:hidden}.exercise{display:flex;align-items:center;gap:17rpx;min-height:108rpx;padding:16rpx 22rpx;border-bottom:1rpx solid #edf0f3}.exercise:last-child{border:0}.part-badge{display:flex;align-items:center;justify-content:center;width:66rpx;height:66rpx;border-radius:13rpx;background:#edfaca;color:#526e1e;font-size:22rpx;font-weight:800}.exercise-main{flex:1}.exercise-name{font-size:26rpx;font-weight:750}.exercise-meta{margin-top:5rpx;color:#858f9c;font-size:19rpx}.edit-link{padding:10rpx;color:#526e1e;font-size:19rpx}.arrow{color:#9ba3ad;font-size:35rpx}.empty{padding:70rpx;text-align:center;color:#8a93a1}.overlay{position:fixed;inset:0;z-index:100;display:flex;align-items:flex-end;background:rgba(13,20,33,.58)}.sheet{width:100%;padding:28rpx 28rpx calc(34rpx + env(safe-area-inset-bottom));border-radius:18rpx 18rpx 0 0;background:#f2f4f7}.sheet-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:26rpx}.sheet-title{font-size:33rpx;font-weight:850}.sheet-head>text{color:#697486;font-size:22rpx}.label{margin:20rpx 0 9rpx;color:#707b8a;font-size:21rpx}.input{width:100%;height:80rpx;padding:0 20rpx;border:1rpx solid #dce1e7;border-radius:12rpx;background:#fff}.choice-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:8rpx}.type-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8rpx}.choice{padding:17rpx 4rpx;border-radius:10rpx;background:#fff;color:#687385;font-size:21rpx;text-align:center}.choice.on{background:#172033;color:#b8f04b}.save{margin-top:28rpx;background:#b8f04b;color:#172033}.delete{margin-top:12rpx;background:transparent;color:#b44747;font-size:22rpx}
