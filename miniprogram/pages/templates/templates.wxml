<view class="page wm-host"><brand-watermark size="page" position="tl" subtle/><view class="wm-content">
  <view class="head"><view><view class="eyebrow">WORKOUT PLANS</view><view class="title">训练模板</view><view class="sub">固定训练结构，一键开始</view></view><button class="add" bindtap="onCreate">＋</button></view>
  <view class="list"><view class="template wm-host" wx:for="{{templates}}" wx:key="id"><brand-watermark size="small" position="br" tone="ink" subtle/><view class="wm-content"><view class="template-head"><view><view class="template-name">{{item.name}}</view><view class="template-meta">{{item.partLabel}} · {{item.items.length}} 个动作 · {{item.setCount}} 组</view></view><button class="start" data-id="{{item.id}}" bindtap="onStart">开始</button></view><view class="actions"><text data-id="{{item.id}}" bindtap="onEdit">编辑</text><text class="danger" data-id="{{item.id}}" bindtap="onDelete">删除</text></view></view></view></view>
  <view class="empty" wx:if="{{!loading&&!templates.length}}"><view class="empty-icon">🔖</view><view class="empty-title">还没有模板</view><view class="empty-sub">把常练动作和组数保存下来，下次一键开始。</view><button bindtap="onCreate">新建模板</button></view>
</view>
<view class="overlay" wx:if="{{editorOpen}}" catchtouchmove="noop"><view class="sheet"><view class="sheet-head"><view class="sheet-title">{{editingId?'编辑模板':'新建模板'}}</view><text bindtap="onClose">关闭</text></view><scroll-view scroll-y class="sheet-scroll"><view class="label">模板名称</view><input class="input" value="{{form.name}}" bindinput="onName" placeholder="如：背 + 二头 A"/><view class="label">主要部位</view><view class="parts"><view wx:for="{{parts}}" wx:key="id" class="chip {{item.selected?'on':''}}" data-id="{{item.id}}" bindtap="onPart">{{item.label}}</view></view><view class="label">已选动作</view><view class="chosen" wx:for="{{form.items}}" wx:key="exerciseId"><view class="chosen-head"><text>{{item.name}}</text><text class="danger" data-index="{{index}}" bindtap="onRemoveItem">移除</text></view><view class="preset"><view><text>重量</text><input type="digit" value="{{item.weight}}" data-index="{{index}}" data-field="weight" bindinput="onItemField" disabled="{{item.weightType==='bodyweight'}}"/></view><view><text>次数</text><input type="number" value="{{item.reps}}" data-index="{{index}}" data-field="reps" bindinput="onItemField"/></view><view><text>组数</text><input type="number" value="{{item.count}}" data-index="{{index}}" data-field="count" bindinput="onItemField"/></view></view></view><view class="label">添加动作</view><view class="exercise-picker"><view wx:for="{{exercises}}" wx:key="id" class="exercise-choice" data-id="{{item.id}}" bindtap="onAddExercise"><text>{{item.name}}</text><text>＋</text></view></view><button class="save" loading="{{busy}}" bindtap="onSave">保存模板</button><view class="bottom-space"></view></scroll-view></view></view>
</view>
