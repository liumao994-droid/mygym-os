.page{min-height:100vh;padding-bottom:60rpx;background:#f2f4f7}.head{display:flex;align-items:center;justify-content:space-between;padding:34rpx 28rpx 22rpx}.title{margin-top:4rpx;font-size:42rpx;font-weight:850}.sub{margin-top:4rpx;color:#7d8795;font-size:21rpx}.add{display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;margin:0;padding:0;border-radius:14rpx;background:#b8f04b;color:#172033;font-size:36rpx}.list{margin:0 24rpx}.template{margin-bottom:16rpx;padding:25rpx;border:1rpx solid #e1e5eb;border-radius:16rpx;background:#fff}.template-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.template-name{font-size:28rpx;font-weight:800}.template-meta{margin-top:6rpx;color:#7f8997;font-size:20rpx}.start{margin:0;padding:0 25rpx;background:#b8f04b;color:#172033;font-size:22rpx;line-height:62rpx}.actions{display:flex;gap:30rpx;margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #edf0f3;color:#667184;font-size:21rpx}.danger{color:#b44747}.empty{margin:0 24rpx;padding:70rpx 30rpx;border:1rpx dashed #ccd2db;border-radius:16rpx;text-align:center}.empty-icon{font-size:54rpx}.empty-title{margin-top:14rpx;font-size:28rpx;font-weight:800}.empty-sub{margin:8rpx auto 22rpx;max-width:480rpx;color:#7d8795;font-size:21rpx}.empty button{width:250rpx;background:#172033;color:#b8f04b;font-size:23rpx}.overlay{position:fixed;inset:0;z-index:100;display:flex;align-items:flex-end;background:rgba(13,20,33,.58)}.sheet{width:100%;max-height:92vh;padding:28rpx 28rpx 0;border-radius:18rpx 18rpx 0 0;background:#f2f4f7}.sheet-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10rpx}.sheet-title{font-size:33rpx;font-weight:850}.sheet-head>text{color:#697486;font-size:22rpx}.sheet-scroll{max-height:82vh}.label{margin:22rpx 0 10rpx;color:#707b8a;font-size:21rpx;font-weight:700}.input{width:100%;height:80rpx;padding:0 20rpx;border:1rpx solid #dce1e7;border-radius:12rpx;background:#fff}.parts{display:grid;grid-template-columns:repeat(6,1fr);gap:8rpx}.chip{padding:17rpx 4rpx;border-radius:10rpx;background:#fff;color:#687385;font-size:21rpx;text-align:center}.chip.on{background:#172033;color:#b8f04b}.chosen{margin-bottom:12rpx;padding:20rpx;border:1rpx solid #e0e5eb;border-radius:13rpx;background:#fff}.chosen-head{display:flex;justify-content:space-between;font-size:23rpx;font-weight:750}.preset{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:15rpx}.preset text{display:block;margin-bottom:6rpx;color:#89919e;font-size:18rpx}.preset input{height:66rpx;padding:0 12rpx;border-radius:9rpx;background:#f0f3f5;text-align:center}.exercise-picker{max-height:330rpx;border:1rpx solid #e0e5eb;border-radius:13rpx;background:#fff;overflow:auto}.exercise-choice{display:flex;justify-content:space-between;padding:19rpx 21rpx;border-bottom:1rpx solid #edf0f3;font-size:22rpx}.save{margin-top:25rpx;background:#b8f04b;color:#172033}.bottom-space{height:60rpx}
